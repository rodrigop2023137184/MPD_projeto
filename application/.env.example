# Copiar este ficheiro para .env e ajustar se for preciso.
# O .env NÃO vai para o Git (está no .gitignore).
#
# Valores de DEMONSTRAÇÃO para o MySQL local em Docker (contentor
# MPD_pesca). Os utilizadores app_* são criados pelo data/programmable_objects.sql.
# Não usar '#' nas palavras-passe: num .env começa um comentário.

# Servidor web da aplicação
PORT=3000

# Base de dados (porta 3307 = a porta publicada no docker-compose.yml)
DB_HOST=localhost
DB_PORT=3307
DB_NAME=sta_princesa

# Um utilizador MySQL por papel (data/programmable_objects.sql, parte 3)
DB_USER_ARMADOR=app_armador
DB_PASS_ARMADOR=Armador-2026

DB_USER_PESCA=app_pesca
DB_PASS_PESCA=Pesca-2026

DB_USER_FABRICA=app_fabrica
DB_PASS_FABRICA=Fabrica-2026

DB_USER_COMANDANTE=app_comandante
DB_PASS_COMANDANTE=Comandante-2026
